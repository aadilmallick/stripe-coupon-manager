# =============================================================================
#  Stripe Coupon Manager — server-side env vars (Netlify / local dev)
# =============================================================================
# These vars are read inside TanStack Start server functions and Netlify
# Functions only. None use the `VITE_` prefix and none are bundled into the
# browser, so it's safe to put real secrets here.
#
# ⚠️  Never commit a real `.env` file. Commit-friendly template lives at
# `.env.example` at the repo root.
#
# Set the same values in:
#   - Netlify dashboard → Site settings → Environment variables  (production)
#   - Add `Deploy previews` if you also want them on PR preview URLs.
#
# After changing any value in Netlify: trigger a fresh deploy — env vars only
# take effect on the next build.
# =============================================================================


# -----------------------------------------------------------------------------
# ADMIN_PUBLISH_SECRET  (required for token management + snapshot publishing)
# -----------------------------------------------------------------------------
# Strong random string. The same value must be entered locally in the running
# app at  Settings → Public API admin secret  — the in-browser RPCs send this
# to the matching server function, which compares against this env var.
# If the two don't byte-match, admin RPCs return "Unauthorized." (HTTP 401).
#
# Generate with:
#     openssl rand -hex 32     # → 64-char hex string
#     op read op://Personal/stripe-coupon-manager/admin_publish_secret
#
# Minimum 8 characters. Longer + high-entropy is strongly recommended.
ADMIN_PUBLISH_SECRET=


# -----------------------------------------------------------------------------
# RESEND_API_KEY  (optional — only required if you use the email dialog)
# -----------------------------------------------------------------------------
# Resend dashboard → API Keys → Create API key. Scoped to "Sending access".
# If unset, the email dialog falls back to a `mailto:` link instead of failing.
RESEND_API_KEY=


# -----------------------------------------------------------------------------
# RESEND_SENDER_DOMAIN  (optional — only used together with RESEND_API_KEY)
# -----------------------------------------------------------------------------
# The verified domain or address you send from in the email dialog.
# Either bare domain:    mail.example.com
# Or full sender addr:   Discount Codes <noreply@example.com>
#
# Must be verified in the Resend dashboard under "Domains".
RESEND_SENDER_DOMAIN=
